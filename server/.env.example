# 雄心意志 · 本地 AI 后台配置
# 用法：把本文件复制为同目录下的 .env，填入你自己的 Key，然后重启后端服务。
# 前端只会通过本机 127.0.0.1 调用，Key 不出本机、不进浏览器。

# ── 服务端口 ──────────────────────────────────────────────
PORT=8787

# ── 豆包（火山方舟，OpenAI 兼容接口）────────────────────────
# BASE_URL 默认已指向火山方舟，如无特殊需求可不改
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
# 填你在火山方舟上创建的推理接入点 ID（形如 ep-2024xxxx）或模型名
DOUBAO_MODEL=

# ── Marvis 这一路（任意 OpenAI 兼容接口）────────────────────
# 例如腾讯云混元 / DeepSeek 官方 / 其它兼容网关，按你实际拿到的填
MARVIS_BASE_URL=
MARVIS_API_KEY=
MARVIS_MODEL=

# ── Ollama（本机免费模型）───────────────────────────────────
# 不用填 Key！只要本机 Ollama 在跑（默认 127.0.0.1:11434），改 model 即可
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
