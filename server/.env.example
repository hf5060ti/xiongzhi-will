# 复制本文件为 .env 后按需填写，改完重启 node server/server.js 生效。
# .env 本身已被 .gitignore 忽略（含 API Key，不要提交）。

# 后台监听端口（vite dev 的 /api 代理默认转发到 8787）
PORT=8787

# ── 豆包（火山方舟，OpenAI 兼容）──
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=

# ── Marvis（任意 OpenAI 兼容接口，三项都填才会启用）──
MARVIS_BASE_URL=
MARVIS_API_KEY=
MARVIS_MODEL=

# ── Ollama（本机离线模型，装好 Ollama 后直接用默认值即可）──
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
